rules_version = '2';

// 한지붕 Firestore 보안 규칙 (명세서 3·17·18장)
// - 사용자가 속한 공간 목록은 로그인 토큰의 맞춤 클레임 `spaces`에 있다 (Worker만 갱신).
// - 공간 구성원 변경, 사진 생성·상태 변경, 중복 정리는 Worker(서비스 계정)만 한다. 서비스 계정은 규칙을 우회한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function mySpaces() {
      return request.auth.token.get('spaces', []);
    }

    // 목록이 비어 있지 않고, 모두 내가 속한 공간인지
    function withinMySpaces(ids) {
      return ids is list && ids.size() > 0 && ids.size() <= 20 && ids.hasOnly(mySpaces());
    }

    function canSee(data) {
      return data.spaceIds.hasAny(mySpaces());
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isSpaceAdmin(spaceId) {
      return signedIn()
        && spaceId in mySpaces()
        && me() in get(/databases/$(database)/documents/spaces/$(spaceId)).data.adminUids;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTimeOrNull(v) {
      return v == null || (v is string && v.matches('^[0-9]{2}:[0-9]{2}$'));
    }

    // ── 사용자 ─────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn() && me() == userId;
      // 문서 생성과 spaceIds는 Worker 몫. 본인은 이름과 설정만 바꾼다.
      allow update: if signedIn() && me() == userId
        && changedKeys().hasOnly(['displayName', 'settings'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.settings is map;

      match /devices/{deviceId} {
        allow read, write: if signedIn() && me() == userId;
      }
    }

    // ── 공간 ───────────────────────────────────────
    match /spaces/{spaceId} {
      allow read: if signedIn() && spaceId in mySpaces();
      allow update: if signedIn()
        && me() in resource.data.adminUids
        && changedKeys().hasOnly(['name', 'color', 'rules'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.rules.photoDelete in ['owner', 'ownerOrAdmin']
        && request.resource.data.rules.onLeave in ['keep', 'remove', 'ask']
        && request.resource.data.rules.eventEditDefault in ['owner', 'all'];

      match /members/{memberId} {
        allow read: if signedIn() && spaceId in mySpaces();
        // 관리자는 프로필 구성원(앱을 안 쓰는 가족)을 직접 추가·수정·삭제한다
        allow create: if isSpaceAdmin(spaceId)
          && request.resource.data.uid == null
          && request.resource.data.spaceId == spaceId
          && request.resource.data.role == 'member'
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 20;
        allow update: if isSpaceAdmin(spaceId)
          && resource.data.uid == null
          && changedKeys().hasOnly(['displayName'])
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 20;
        allow delete: if isSpaceAdmin(spaceId) && resource.data.uid == null;
      }
    }

    // ── 항목 (일정·기념일) ────────────────────────
    function validItem(d) {
      return d.kind in ['event', 'anniversary']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.memo is string && d.memo.size() <= 2000
        && d.spaceIds is list && d.spaceIds.size() > 0 && d.spaceIds.size() <= 20
        && isDate(d.date)
        && (d.endDate == null || isDate(d.endDate))
        && isTimeOrNull(d.time) && isTimeOrNull(d.endTime)
        && d.allDay is bool
        && d.coEdit is bool
        && d.repeat in ['none', 'weekly', 'monthly', 'yearly']
        && d.mode in ['countdown', 'since']
        && d.reminders is list && d.reminders.size() <= 10
        && d.participants is list && d.participants.size() <= 30
        && d.updatedAt is int
        && d.updatedBy == me();
    }

    match /items/{itemId} {
      allow read: if signedIn() && canSee(resource.data);

      allow create: if signedIn()
        && validItem(request.resource.data)
        && request.resource.data.ownerUid == me()
        && withinMySpaces(request.resource.data.spaceIds);

      allow update: if signedIn()
        && validItem(request.resource.data)
        && !changedKeys().hasAny(['ownerUid', 'createdAt'])
        && (
          // 만든 사람: 공유 범위까지 자유롭게
          (resource.data.ownerUid == me() && withinMySpaces(request.resource.data.spaceIds))
          // 다른 가족도 수정 가능: 내용만, 공유 범위·수정 권한은 못 바꿈
          || (resource.data.coEdit == true
              && canSee(resource.data)
              && !changedKeys().hasAny(['spaceIds', 'coEdit']))
          // 공간 관리자: 자기 공간에서 빼기만
          || (changedKeys().hasOnly(['spaceIds', 'updatedAt', 'updatedBy'])
              && resource.data.spaceIds.hasAll(request.resource.data.spaceIds)
              && resource.data.spaceIds.removeAll(request.resource.data.spaceIds).size() == 1
              && isSpaceAdmin(resource.data.spaceIds.removeAll(request.resource.data.spaceIds)[0]))
        );

      allow delete: if signedIn() && resource.data.ownerUid == me();
    }

    // ── 사진 (쓰기는 Worker만) ─────────────────────
    match /photos/{photoId} {
      allow read: if signedIn()
        && (resource.data.ownerUid == me()
            || (resource.data.status == 'active' && canSee(resource.data)));
    }

    // ── 앨범 ───────────────────────────────────────
    match /albums/{albumId} {
      allow read: if signedIn() && canSee(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && withinMySpaces(request.resource.data.spaceIds);
      allow update: if signedIn()
        && resource.data.ownerUid == me()
        && !changedKeys().hasAny(['ownerUid', 'createdAt'])
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && withinMySpaces(request.resource.data.spaceIds);
      allow delete: if signedIn() && resource.data.ownerUid == me();
    }

    // ── 중복 정리 (Worker가 쓰고 관리자가 읽음) ────
    match /dedupeGroups/{groupId} {
      allow read: if isSpaceAdmin(resource.data.spaceId);
    }

    match /mergeRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.ownerUid == me() || resource.data.requestedBy == me());
    }

    // 그 외는 모두 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
