# 앱 설정값 (공개돼도 되는 값만). 로컬 실행: 이 파일을 .env로 복사해서 채운다.
# EAS 빌드·Cloudflare Pages에는 같은 이름으로 환경 변수를 넣는다 (docs/SETUP.md 값 정리표).
# 이 값이 비어 있거나 EXPO_PUBLIC_DEMO=1이면 앱은 예시 가족 데이터(데모)로 동작한다.

# Firebase 웹 앱 설정 (기존 d-day-app 프로젝트 값, 공개 값)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBq6wADijXkVUOqw44Pv5BKN0xJ9BtS11Q
EXPO_PUBLIC_FIREBASE_APP_ID=1:39953405485:web:3e655af75dcde652ce8aa4
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=d-day-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=d-day-app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=39953405485

# Worker 주소 (scripts/setup-cloudflare.sh 가 마지막에 알려줌)
EXPO_PUBLIC_API_URL=
# 웹 주소 (Cloudflare Pages)
EXPO_PUBLIC_WEB_ORIGIN=https://hanjibung.pages.dev

# Google OAuth 웹 클라이언트 ID (docs/SETUP.md 2-3)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 카카오 앱 키 (docs/SETUP.md 3-1)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# 1로 두면 설정이 있어도 데모 데이터로 동작
EXPO_PUBLIC_DEMO=
